{
  "name": "SectorRun",
  "type": "object",
  "description": "S6+ run records for sector + trial arenas (everything that isn't endless, raid, or meteor). Replaces RunScore for non-endless runs starting at S6 rollover (W21, 2026-05-18). S5 sector runs stay in RunScore as archive.",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "wallet_address": {
      "type": "string",
      "description": "OmenX wallet address \u2014 canonical identity for rewards"
    },
    "player_name": {
      "type": "string"
    },
    "player_title": {
      "type": "string"
    },
    "pilot_icon": {
      "type": "string"
    },
    "score": {
      "type": "number"
    },
    "time_survived": {
      "type": "number"
    },
    "level": {
      "type": "number"
    },
    "kills": {
      "type": "number"
    },
    "gold_earned": {
      "type": "number",
      "description": "Raw gold the client reported for this run"
    },
    "gold_credited": {
      "type": "number",
      "description": "Gold actually credited to PlayerSave (caps applied)"
    },
    "character_id": {
      "type": "string"
    },
    "arena_id": {
      "type": "string",
      "description": "Sector arena id (station, asteroid, ..., dimension) or trial arena id"
    },
    "is_victory": {
      "type": "boolean",
      "description": "True if the player defeated the sector boss"
    },
    "is_trial": {
      "type": "boolean",
      "default": false,
      "description": "True for Leviathan Trial runs (replaces filtering by arena id)"
    },
    "difficulty_id": {
      "type": "string"
    },
    "week_id": {
      "type": "string"
    },
    "season_id": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "wallet_address",
    "player_name",
    "score",
    "week_id",
    "season_id"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}