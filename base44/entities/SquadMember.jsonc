{
  "name": "SquadMember",
  "type": "object",
  "properties": {
    "squad_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "player_name": {
      "type": "string"
    },
    "player_title": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "leader",
        "member"
      ],
      "default": "member"
    },
    "last_payout_week": {
      "type": "string"
    },
    "last_daily_payout_date": {
      "type": "string"
    }
  },
  "required": [
    "squad_id",
    "user_id",
    "player_name"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {},
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}