{
  "name": "SquadChampionsPayoutLog",
  "properties": {
    "amount": {
      "description": "OMENX amount paid to this member",
      "type": "number"
    },
    "period_id": {
      "description": "Season id, e.g. 2026-S5",
      "type": "string"
    },
    "squad_id": {
      "type": "string"
    },
    "squad_name": {
      "type": "string"
    },
    "squad_rank": {
      "description": "1, 2, or 3",
      "type": "number"
    },
    "squad_tag": {
      "type": "string"
    },
    "status": {
      "default": "success",
      "description": "'pending' (added 2026-10-21) = log-first row written before the grant; becomes 'success' on a clear yes, deleted on a clear no, left pending on an unclear answer.",
      "enum": [
        "success",
        "failed",
        "rolled_over",
        "pending"
      ],
      "type": "string"
    },
    "tx_id": {
      "description": "Omen transaction id. 'pending-\u2026' = written before paying and Omen's answer was unclear; check the Omen portal (run-book 5.2).",
      "type": "string"
    },
    "wallet_address": {
      "description": "Recipient wallet (lowercase)",
      "type": "string"
    }
  },
  "required": [
    "period_id",
    "wallet_address",
    "amount"
  ],
  "type": "object",
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}