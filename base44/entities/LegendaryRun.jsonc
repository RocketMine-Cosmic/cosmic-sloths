{
  "name": "LegendaryRun",
  "type": "object",
  "properties": {
    "season_id": {
      "type": "string",
      "description": "Season this legendary run belongs to (e.g. 2026-S5)"
    },
    "rank": {
      "type": "number",
      "description": "Final leaderboard rank (1 = top) for this season"
    },
    "wallet_address": {
      "type": "string",
      "description": "Player's wallet address (lowercase)"
    },
    "player_name": {
      "type": "string"
    },
    "player_title": {
      "type": "string"
    },
    "pilot_icon": {
      "type": "string"
    },
    "score": {
      "type": "number"
    },
    "time_survived": {
      "type": "number"
    },
    "level": {
      "type": "number"
    },
    "kills": {
      "type": "number"
    },
    "character_id": {
      "type": "string"
    },
    "arena_id": {
      "type": "string"
    },
    "original_run_id": {
      "type": "string",
      "description": "ID of the source RunScore record (for traceability)"
    },
    "original_created_date": {
      "type": "string",
      "description": "Original RunScore.created_date so the Hall of Fame shows the actual achievement date"
    }
  },
  "required": [
    "season_id",
    "rank",
    "wallet_address",
    "player_name",
    "score"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}