{
  "name": "SquadMessage",
  "type": "object",
  "properties": {
    "squad_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "player_name": {
      "type": "string"
    },
    "content": {
      "type": "string"
    }
  },
  "required": [
    "squad_id",
    "user_id",
    "player_name",
    "content"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.squad_id": "{{user.data.squad_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "write": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}