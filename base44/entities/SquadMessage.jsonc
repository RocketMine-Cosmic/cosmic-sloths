{
  "name": "SquadMessage",
  "type": "object",
  "properties": {
    "squad_id": {
      "type": "string"
    },
    "wallet_address": {
      "type": "string",
      "description": "Wallet address of the message author"
    },
    "player_name": {
      "type": "string"
    },
    "player_title": {
      "type": "string"
    },
    "content": {
      "type": "string"
    }
  },
  "required": [
    "squad_id",
    "wallet_address",
    "player_name",
    "content"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {
      "$or": [
        {
          "data.wallet_address": "{{user.wallet_address}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}