{
  "name": "PlayerSave",
  "type": "object",
  "properties": {
    "wallet_address": {
      "type": "string",
      "unique": true
    },
    "player_name": {
      "type": "string",
      "description": "Player's display name (mirrored from save_data for easy admin search)"
    },
    "save_data": {
      "type": "object",
      "additionalProperties": true
    },
    "updated_at": {
      "type": "number"
    }
  },
  "required": [
    "wallet_address",
    "save_data"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.wallet_address": "{{user.data.wallet_address}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}