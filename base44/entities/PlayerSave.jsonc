{
  "name": "PlayerSave",
  "type": "object",
  "properties": {
    "wallet_address": {
      "type": "string"
    },
    "save_data": {
      "type": "object",
      "additionalProperties": true
    },
    "updated_at": {
      "type": "number"
    }
  },
  "required": [
    "wallet_address",
    "save_data"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "data.wallet_address": "{{user.wallet_address}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.wallet_address": "{{user.wallet_address}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}