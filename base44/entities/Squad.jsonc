{
  "name": "Squad",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "unique": true
    },
    "tag": {
      "type": "string",
      "unique": true
    },
    "description": {
      "type": "string"
    },
    "owner_wallet": {
      "type": "string",
      "description": "Wallet address of the squad owner"
    },
    "icon": {
      "type": "string",
      "description": "Squad emoji icon"
    },
    "weekly_kills": {
      "type": "number",
      "default": 0
    },
    "current_week": {
      "type": "string"
    },
    "daily_kills": {
      "type": "number",
      "default": 0
    },
    "current_day": {
      "type": "string"
    },
    "member_count": {
      "type": "number",
      "default": 1
    },
    "xp": {
      "type": "number",
      "default": 0
    },
    "level": {
      "type": "number",
      "default": 1
    }
  },
  "required": [
    "name",
    "tag",
    "owner_wallet"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}