{
  "name": "Squad",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "unique": true
    },
    "tag": {
      "type": "string",
      "unique": true
    },
    "description": {
      "type": "string"
    },
    "owner_wallet": {
      "type": "string",
      "description": "Wallet address of the squad owner"
    },
    "icon": {
      "type": "string",
      "description": "Squad emoji icon"
    },
    "privacy": {
      "type": "string",
      "enum": [
        "open",
        "request",
        "closed"
      ],
      "default": "open",
      "description": "open = anyone can join instantly. request = leader/officers approve. closed = no new joins."
    },
    "weekly_kills": {
      "type": "number",
      "default": 0
    },
    "current_week": {
      "type": "string"
    },
    "daily_kills": {
      "type": "number",
      "default": 0
    },
    "current_day": {
      "type": "string"
    },
    "member_count": {
      "type": "number",
      "default": 1
    },
    "xp": {
      "type": "number",
      "default": 0
    },
    "level": {
      "type": "number",
      "default": 1
    },
    "war_wins": {
      "type": "number",
      "default": 0,
      "description": "Lifetime Squad War wins"
    },
    "war_losses": {
      "type": "number",
      "default": 0,
      "description": "Lifetime Squad War losses"
    },
    "war_ties": {
      "type": "number",
      "default": 0,
      "description": "Lifetime Squad War ties"
    },
    "war_streak": {
      "type": "number",
      "default": 0,
      "description": "Current consecutive win streak (resets on loss/tie)"
    },
    "last_daily_xp_award_date": {
      "type": "string",
      "description": "Date (YYYY-MM-DD UTC) of the last daily-bounty XP bonus payout."
    }
  },
  "required": [
    "name",
    "tag",
    "owner_wallet"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}