{
  "name": "Squad",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "tag": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "owner_id": {
      "type": "string"
    },
    "weekly_kills": {
      "type": "number",
      "default": 0
    },
    "current_week": {
      "type": "string"
    },
    "member_count": {
      "type": "number",
      "default": 1
    }
  },
  "required": [
    "name",
    "tag"
  ],
  "rls": {
    "create": {
      "data.owner_id": "{{user.id}}"
    },
    "read": {},
    "update": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}