{
  "name": "Squad",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "tag": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "owner_wallet": {
      "type": "string",
      "description": "Wallet address of the squad owner"
    },
    "icon": {
      "type": "string",
      "description": "Squad emoji icon"
    },
    "weekly_kills": {
      "type": "number",
      "default": 0
    },
    "current_week": {
      "type": "string"
    },
    "daily_kills": {
      "type": "number",
      "default": 0
    },
    "current_day": {
      "type": "string"
    },
    "member_count": {
      "type": "number",
      "default": 1
    },
    "xp": {
      "type": "number",
      "default": 0
    },
    "level": {
      "type": "number",
      "default": 1
    }
  },
  "required": [
    "name",
    "tag",
    "owner_wallet"
  ],
  "rls": {
    "create": {
      "authenticated": true
    },
    "read": {},
    "update": {
      "$or": [
        {
          "data.owner_wallet": "{{user.wallet_address}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_wallet": "{{user.wallet_address}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}