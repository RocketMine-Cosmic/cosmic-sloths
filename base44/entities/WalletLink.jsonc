{
  "name": "WalletLink",
  "properties": {
    "source": {
      "description": "'omen_verified' (linkWalletToUser) or 'backfill_2026_10_21' (copied from User.wallet_address at cut-over).",
      "type": "string"
    },
    "user_id": {
      "description": "Base44 User.id this wallet is linked to. One row per user.",
      "type": "string"
    },
    "verified_at_ms": {
      "description": "Unix ms of the write.",
      "type": "number"
    },
    "wallet_address": {
      "description": "Lowercase Omen wallet, written ONLY by the server after Omen verified the player's OAuth token (linkWalletToUser) or by the one-off backfill. The single source of truth for 'which wallet is this caller' \u2014 User.wallet_address is player-writable via auth.updateMe and must not be trusted (2026-10-21).",
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "wallet_address"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "type": "object"
}