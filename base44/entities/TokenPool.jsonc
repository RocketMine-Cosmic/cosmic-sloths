{
  "name": "TokenPool",
  "type": "object",
  "properties": {
    "period_id": {
      "type": "string"
    },
    "period_type": {
      "type": "string"
    },
    "total_spent": {
      "type": "number"
    },
    "distributed": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "period_id",
    "period_type",
    "total_spent"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}