{
  "name": "AdminWallet",
  "type": "object",
  "properties": {
    "wallet_address": {
      "type": "string",
      "description": "OmenX wallet address with admin privileges"
    },
    "admin_name": {
      "type": "string",
      "description": "Display name for the admin"
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Admin permission scopes (e.g. 'view_data', 'distribute_rewards', 'manage_admins')"
    },
    "notes": {
      "type": "string",
      "description": "Internal notes about this admin"
    }
  },
  "required": [
    "wallet_address"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {},
    "delete": {}
  }
}