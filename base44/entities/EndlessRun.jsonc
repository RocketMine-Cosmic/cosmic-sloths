{
  "name": "EndlessRun",
  "type": "object",
  "description": "S6+ run records for endless arena only. Replaces RunScore for endless runs starting at S6 rollover (W21, 2026-05-18). S5 endless runs stay in RunScore as archive.",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "wallet_address": {
      "type": "string",
      "description": "OmenX wallet address \u2014 canonical identity for rewards"
    },
    "player_name": {
      "type": "string"
    },
    "player_title": {
      "type": "string"
    },
    "pilot_icon": {
      "type": "string"
    },
    "score": {
      "type": "number"
    },
    "time_survived": {
      "type": "number"
    },
    "level": {
      "type": "number"
    },
    "kills": {
      "type": "number"
    },
    "gold_earned": {
      "type": "number"
    },
    "gold_credited": {
      "type": "number"
    },
    "character_id": {
      "type": "string"
    },
    "starting_weapon_id": {
      "type": "string",
      "description": "Weapon the player started endless with (powers weapon-locked endless leaderboards)"
    },
    "difficulty_id": {
      "type": "string"
    },
    "endless_gold_capped": {
      "type": "boolean",
      "default": false
    },
    "endless_kills_capped": {
      "type": "boolean",
      "default": false
    },
    "week_id": {
      "type": "string"
    },
    "season_id": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "wallet_address",
    "player_name",
    "score",
    "week_id",
    "season_id"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}