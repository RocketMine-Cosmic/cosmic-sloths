{
  "name": "PendingReward",
  "type": "object",
  "properties": {
    "player_name": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "reason": {
      "type": "string"
    },
    "period_id": {
      "type": "string"
    },
    "claimed": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "player_name",
    "amount",
    "reason",
    "period_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.player_name": "{{user.full_name}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.player_name": "{{user.full_name}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}