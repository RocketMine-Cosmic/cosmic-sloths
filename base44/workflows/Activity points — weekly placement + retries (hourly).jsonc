{
  "name": "Activity points \u2014 weekly placement + retries (hourly)",
  "description": "Grants Omen activity points for last week's board placements (top 10 of the weekly score and kills boards, read from PayoutLog once the Monday payouts are done), Squad War wins and Squad Champions, and retries any activity point grant left unfinished. Safe to repeat: every grant has a fixed key, so a second run grants nothing new. Does nothing while AppConfig 'points_config'.enabled is false. Added 21 Oct 2026; plan in project doc claude/handoffs/ACTIVITY_POINTS.md.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 1,
      "interval_unit": "hours",
      "interval_anchor": "2026-10-21T09:17:00Z",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "then": "end",
          "with": {
            "args": {},
            "function_name": "grantWeeklyPlacementPoints"
          }
        }
      }
    ],
    "document": {
      "dsl": "1.0.0",
      "name": "activity_points_weekly",
      "namespace": "base44",
      "version": "1.0"
    }
  }
}