{
  "name": "Refresh store prices (hourly)",
  "description": "Fetches the Omen product catalogue once an hour (at :07) and saves it (AppConfig 'omen_store_prices') for every player's game to read via getSkuPrices. Was every 5 min (21 Oct - 4 Nov 2026), ~288 Omen calls a day, about half the game's Omen requests; hourly per Rob 4 Nov. If this stops, getSkuPrices falls back to fetching Omen itself after 2 hours. The price charged is read live by purchaseSku at buy time.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 1,
      "interval_unit": "hours",
      "interval_anchor": "2026-11-04T01:07:00Z",
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "then": "end",
          "with": {
            "args": {},
            "function_name": "refreshSkuPrices"
          }
        }
      }
    ],
    "document": {
      "dsl": "1.0.0",
      "name": "refresh_store_prices",
      "namespace": "base44",
      "version": "1.0"
    }
  }
}